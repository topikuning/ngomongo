{
  "name": "ngomongo",
  "version": "1.0.0",
  "description": "WhatsApp AI bot dengan dashboard admin, dideploy di Railway",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/dashboard && cp src/dashboard/index.html dist/dashboard/index.html",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.1",
    "@fastify/basic-auth": "^6.1.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@langchain/community": "^0.3.40",
    "@langchain/core": "^0.3.45",
    "@langchain/deepseek": "^0.1.0",
    "@langchain/google-genai": "^0.2.5",
    "@langchain/groq": "^0.2.0",
    "@langchain/openai": "^0.4.5",
    "@prisma/client": "^6.6.0",
    "adm-zip": "^0.5.16",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "langchain": "^0.3.21",
    "undici": "^7.5.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.10",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
