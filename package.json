{
  "name": "ngomongo",
  "version": "1.0.0",
  "description": "WhatsApp AI bot dengan dashboard admin, dideploy di Railway",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/dashboard && cp src/dashboard/index.html dist/dashboard/index.html",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/groq": "^1.2.1",
    "@langchain/mistralai": "^1.1.0",
    "@langchain/openai": "^1.4.7",
    "@prisma/client": "^6.19.3",
    "adm-zip": "^0.5.17",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "langchain": "^1.4.2",
    "undici": "^8.3.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.5"
  }
}
