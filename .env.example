# Otomatis di-inject oleh Railway saat menambahkan PostgreSQL & Redis service.
# Untuk lokal, isi sesuai docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ngomongo?schema=public
REDIS_URL=redis://localhost:6379

# WAHA service (Railway internal URL atau lokal docker-compose)
WAHA_URL=http://localhost:3001
WAHA_API_KEY=ganti-dengan-api-key-waha
WAHA_SESSION=default

# Kredensial admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini

# Port HTTP backend
PORT=3000

# Berapa pesan baru sebelum auto-summarize (default 15)
MEMORY_SUMMARIZE_EVERY=15
# Berapa pesan terakhir yang disimpan di buffer recent (default 10)
MEMORY_RECENT_LIMIT=10
